         trọng số bộ gốc sẽ lệch tổng 100 khi gỡ cầu nối và đổi số liệu kịch bản demo). -->
    <data noupdate="1">
        <record id="kpi_metric_s1" model="kpi.metric">
            <field name="code">S1</field>
            <field name="name">Mức đáp ứng kỹ năng</field>
            <field name="category">process</field>
            <field name="unit">%</field>
            <field name="direction">higher</field>
            <field name="compute_mode">auto</field>
            <field name="description">Số kỹ năng nhân viên đạt / số kỹ năng yêu cầu của chức danh (đã chụp trên phiếu) × 100, so theo mức tiến độ kỹ năng, xét các kỹ năng còn hiệu lực tại ngày cuối kỳ. Thiếu kỹ năng tính là không đạt; chức danh không yêu cầu kỹ năng nào thì Không áp dụng.</field>
        </record>
