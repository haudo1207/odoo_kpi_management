<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: group gắn vào privilege (privilege_id), privilege gắn vào category -->
    <record id="res_groups_privilege_kpi" model="res.groups.privilege">
        <field name="name">KPI</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_kpi_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Xem phiếu đánh giá của chính mình.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_kpi"/>
    </record>

    <record id="group_kpi_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Quản lý trực tiếp: tính KPI, chấm D9, điều chỉnh điểm và gửi duyệt phiếu của nhân viên mình quản lý.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_kpi"/>
        <field name="implied_ids" eval="[(4, ref('group_kpi_user')), (4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="group_kpi_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Cấu hình KPI, duyệt, trả về và mở lại mọi phiếu.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_kpi"/>
        <field name="implied_ids" eval="[(4, ref('group_kpi_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Mọi nhân viên nội bộ đều là KPI User để xem phiếu của mình -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_kpi_user'))]"/>
    </record>

    <!-- Phiếu đánh giá: quy tắc của các group được cộng (OR) theo từng thao tác -->
    <record id="kpi_evaluation_rule_own" model="ir.rule">
        <field name="name">KPI: xem phiếu của mình</field>
        <field name="model_id" ref="model_kpi_evaluation"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Quản lý chỉ sửa phiếu của nhân viên mình quản lý trực tiếp, không sửa phiếu của chính mình -->
    <record id="kpi_evaluation_rule_team" model="ir.rule">
        <field name="name">KPI: quản lý phiếu của nhân viên trực tiếp</field>
        <field name="model_id" ref="model_kpi_evaluation"/>
        <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_manager'))]"/>
    </record>

    <record id="kpi_evaluation_rule_all" model="ir.rule">
        <field name="name">KPI: tất cả phiếu</field>
        <field name="model_id" ref="model_kpi_evaluation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_admin'))]"/>
    </record>

    <record id="kpi_evaluation_line_rule_own" model="ir.rule">
        <field name="name">KPI: xem dòng phiếu của mình</field>
        <field name="model_id" ref="model_kpi_evaluation_line"/>
        <field name="domain_force">[('evaluation_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="kpi_evaluation_line_rule_team" model="ir.rule">
        <field name="name">KPI: dòng phiếu của nhân viên trực tiếp</field>
        <field name="model_id" ref="model_kpi_evaluation_line"/>
        <field name="domain_force">[('evaluation_id.employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_manager'))]"/>
    </record>

    <record id="kpi_evaluation_line_rule_all" model="ir.rule">
        <field name="name">KPI: tất cả dòng phiếu</field>
        <field name="model_id" ref="model_kpi_evaluation_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_admin'))]"/>
    </record>
</odoo>
