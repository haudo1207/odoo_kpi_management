<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_update_days_late" model="ir.cron">
        <field name="name">KPI: cập nhật số ngày trễ của task chưa xong</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_days_late()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_generate_evaluations" model="ir.cron">
        <field name="name">KPI: tạo phiếu đánh giá khi hết kỳ</field>
        <field name="model_id" ref="model_kpi_period"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_evaluations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
