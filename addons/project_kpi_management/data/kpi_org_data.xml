<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cấu hình mẫu luôn có sẵn sau khi cài module, không phụ thuộc cờ cài demo: phòng ban,
         chức danh và bộ KPI Tester, để chứng minh thêm vai trò mới chỉ cần cấu hình (Phase 8).
         noupdate="1": lệnh -u không ghi đè tên, mục tiêu đã chỉnh trên giao diện. -->
    <data noupdate="1">
        <record id="hr_department_dev" model="hr.department">
            <field name="name">Phòng Phát triển phần mềm</field>
        </record>

        <record id="hr_job_manager" model="hr.job">
            <field name="name">Trưởng nhóm phát triển</field>
            <field name="department_id" ref="hr_department_dev"/>
        </record>

        <record id="hr_job_developer" model="hr.job">
            <field name="name">Lập trình viên</field>
            <field name="department_id" ref="hr_department_dev"/>
            <field name="kpi_template_id" ref="kpi_template_developer"/>
        </record>

        <record id="kpi_period_current_month" model="kpi.period">
            <field name="name" eval="'Tháng ' + DateTime.today().strftime('%m/%Y')"/>
            <field name="period_type">month</field>
            <field name="date_from" eval="DateTime.today().replace(day=1).strftime('%Y-%m-%d')"/>
            <field name="date_to" eval="((DateTime.today().replace(day=28) + relativedelta(days=4)).replace(day=1) - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Phase 8 + Bước 2: vai trò Tester chỉ cấu hình bằng dữ liệu. QA1-QA3 là chỉ số "domain" —
             khai báo hoàn toàn bằng bản ghi này, KHÔNG có hàm Python (mục đích chính của Bước 2);
             QA4 cần hàm _metric_qa4 vì tập dự án suy ra từ dữ liệu bug; QA5 nhập tay.
             Mã QA1-QA5 (không dùng T1-T5: T1-T3 đã thuộc bộ Tester cũ, mã chỉ số UNIQUE; không dùng T4-T8 vì
             trùng tên với "lỗi lọt production" ở tài liệu thiết kế cũ). Database đã cài được chuyển bằng
             migrations/19.0.1.1.0/. Bản ghi cũ (noupdate) không sửa được bằng XML.
             Rủi ro QA1: tách một lỗi thành nhiều bug để tăng số lượng. Hai lớp chặn: QA2 (bug trùng/không
             hợp lệ bị trừ điểm) và quản lý phân loại bug (bug_resolution) trước khi chốt kỳ. -->
        <record id="kpi_metric_qa1" model="kpi.metric">
            <field name="code">QA1</field>
            <field name="name">Số bug hợp lệ tìm được</field>
            <field name="category">quality</field>
            <field name="unit">bug</field>
            <field name="direction">higher</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'bug_reporter_id')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'create_date')]"/>
            <field name="aggregation">count</field>
            <field name="numerator_domain">[('task_type', '=', 'bug'), ('bug_resolution', 'in', ['valid', 'wont_fix'])]</field>
            <field name="description">Bug do tester log trong kỳ (bug_reporter_id, ngày tạo) có kết quả xử lý là lỗi thật (valid, wont_fix). Rủi ro: tách một lỗi thành nhiều bug — bị chặn bởi QA2 và việc phân loại bug của quản lý.</field>
        </record>
        <record id="kpi_metric_qa2" model="kpi.metric">
            <field name="code">QA2</field>
            <field name="name">Tỷ lệ bug bị từ chối</field>
            <field name="category">quality</field>
            <field name="unit">%</field>
            <field name="direction">lower</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'bug_reporter_id')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'create_date')]"/>
            <field name="aggregation">ratio</field>
            <field name="numerator_domain">[('task_type', '=', 'bug'), ('bug_resolution', 'in', ['invalid', 'duplicate'])]</field>
            <field name="denominator_domain">[('task_type', '=', 'bug'), ('bug_resolution', '!=', False)]</field>
            <field name="description">Bug trùng/không phải lỗi / bug đã được phân loại × 100. Mẫu số chỉ gồm bug đã có kết quả xử lý.</field>
        </record>
        <record id="kpi_metric_qa3" model="kpi.metric">
            <field name="code">QA3</field>
            <field name="name">Tỷ lệ bug đủ phân loại</field>
            <field name="category">process</field>
            <field name="unit">%</field>
            <field name="direction">higher</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'bug_reporter_id')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'create_date')]"/>
            <field name="aggregation">ratio</field>
            <field name="numerator_domain">[('task_type', '=', 'bug'), ('origin_task_id', '!=', False), ('bug_root_cause', '!=', False)]</field>
            <field name="denominator_domain">[('task_type', '=', 'bug')]</field>
            <field name="description">Bug có task gốc và nguyên nhân / mọi bug tester log trong kỳ × 100.</field>
        </record>
        <record id="kpi_metric_qa4" model="kpi.metric">
            <field name="code">QA4</field>
            <field name="name">Lỗi lọt production của dự án tham gia</field>
            <field name="category">quality</field>
            <field name="unit">%</field>
            <field name="direction">lower</field>
            <field name="compute_mode">auto</field>
            <field name="description">Bug production / bug hợp lệ trong các dự án tester đã log bug trong kỳ × 100. Khối lượng = số dự án tham gia.</field>
        </record>
        <record id="kpi_metric_qa5" model="kpi.metric">
            <field name="code">QA5</field>
            <field name="name">Đánh giá của quản lý (Tester)</field>
            <field name="category">collaboration</field>
            <field name="unit">điểm</field>
            <field name="direction">higher</field>
            <field name="compute_mode">manual</field>
            <field name="description">Quản lý chấm trên thang 1-5 cho thái độ, phối hợp, chất lượng báo cáo bug.</field>
        </record>
        <record id="kpi_template_tester_auto" model="kpi.template">
            <field name="name">Tester (tự động)</field>
            <field name="description">Bộ KPI kiểm thử viên: QA1-QA3 tính tự động bằng cấu hình, QA4 bằng hàm Python, QA5 quản lý nhập.</field>
            <field name="line_ids" eval="[
                (0, 0, {'sequence': 1, 'metric_id': ref('kpi_metric_qa1'), 'target': 15, 'weight': 25, 'min_volume': 0}),
                (0, 0, {'sequence': 2, 'metric_id': ref('kpi_metric_qa2'), 'target': 10, 'weight': 20, 'min_volume': 3}),
                (0, 0, {'sequence': 3, 'metric_id': ref('kpi_metric_qa3'), 'target': 90, 'weight': 15, 'min_volume': 3}),
                (0, 0, {'sequence': 4, 'metric_id': ref('kpi_metric_qa4'), 'target': 5, 'weight': 25, 'min_volume': 1}),
                (0, 0, {'sequence': 5, 'metric_id': ref('kpi_metric_qa5'), 'target': 4, 'weight': 15, 'min_volume': 0}),
            ]"/>
        </record>
        <!-- Bước 4 (Chương 9.2, Ưu tiên 2): bộ Team Lead / PM. P1 chỉ là cấu hình (domain); P2, P3 cần hàm vì
             lấy dữ liệu từ phiếu cấp dưới và báo cáo chất lượng dữ liệu; P5 nhập tay. P4 (giờ thực tế so với
             kế hoạch) nằm ở module cầu nối project_kpi_timesheet vì cần hr_timesheet.
             "Dự án của Lead" = project.project.user_id (Quản lý dự án), cùng cách xác định ở P1 và P3. -->
        <record id="kpi_metric_p1" model="kpi.metric">
            <field name="code">P1</field>
            <field name="name">Tỷ lệ milestone đạt đúng hạn</field>
            <field name="category">delivery</field>
            <field name="unit">%</field>
            <field name="direction">higher</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_milestone"/>
            <field name="date_field_id" search="[('model', '=', 'project.milestone'), ('name', '=', 'deadline')]"/>
            <field name="aggregation">ratio</field>
            <field name="numerator_domain">[('is_reached_on_time', '=', True), ('project_id.user_id', 'in', ['$CURRENT_USER_ID'])]</field>
            <field name="denominator_domain">[('project_id.user_id', 'in', ['$CURRENT_USER_ID'])]</field>
            <field name="description">Milestone của dự án do Lead quản lý, có deadline trong kỳ, đã đạt không muộn hơn deadline / tổng milestone có deadline trong kỳ × 100. Milestone chưa đạt mà quá hạn tính là trễ; kỳ chưa kết thúc thì milestone chưa tới hạn cũng chưa đạt nên nên chốt sau kỳ.</field>
        </record>
        <record id="kpi_metric_p2" model="kpi.metric">
            <field name="code">P2</field>
            <field name="name">Điểm KPI trung bình của team</field>
            <field name="category">collaboration</field>
            <field name="unit">điểm</field>
            <field name="direction">higher</field>
            <field name="compute_mode">auto</field>
            <field name="description">Điểm cuối trung bình của cấp dưới trực tiếp, chỉ tính phiếu cùng kỳ đã Gửi/Đã duyệt. Dưới khối lượng tối thiểu (số phiếu) thì Không áp dụng.</field>
        </record>
        <record id="kpi_metric_p3" model="kpi.metric">
            <field name="code">P3</field>
            <field name="name">Chất lượng dữ liệu dự án</field>
            <field name="category">process</field>
            <field name="unit">%</field>
            <field name="direction">higher</field>
            <field name="compute_mode">auto</field>
            <field name="description">Tiêu chí dữ liệu sạch / tổng tiêu chí của các dự án Lead quản lý, chỉ xét bản ghi thuộc kỳ: Feature xong trong kỳ có story point; bug tạo trong kỳ có task gốc và đủ phân loại.</field>
        </record>
        <record id="kpi_metric_p5" model="kpi.metric">
            <field name="code">P5</field>
            <field name="name">Đánh giá của cấp trên (Lead/PM)</field>
            <field name="category">collaboration</field>
            <field name="unit">điểm</field>
            <field name="direction">higher</field>
            <field name="compute_mode">manual</field>
            <field name="description">Cấp trên chấm thang 1-5 về điều phối, giao tiếp, giải quyết vướng mắc.</field>
        </record>
        <record id="kpi_template_lead" model="kpi.template">
            <field name="name">Team Lead / PM</field>
            <field name="description">Bộ KPI cho trưởng nhóm / quản lý dự án (P1, P2, P3, P5). Cài thêm module project_kpi_timesheet để có P4 (giờ thực tế so với kế hoạch).</field>
            <field name="line_ids" eval="[
                (0, 0, {'sequence': 1, 'metric_id': ref('kpi_metric_p1'), 'target': 80, 'weight': 25, 'min_volume': 2}),
                (0, 0, {'sequence': 2, 'metric_id': ref('kpi_metric_p2'), 'target': 80, 'weight': 25, 'min_volume': 2}),
                (0, 0, {'sequence': 3, 'metric_id': ref('kpi_metric_p3'), 'target': 90, 'weight': 20, 'min_volume': 10}),
                (0, 0, {'sequence': 4, 'metric_id': ref('kpi_metric_p5'), 'target': 4, 'weight': 30, 'min_volume': 0}),
            ]"/>
        </record>
        <record id="hr_job_pm" model="hr.job">
            <field name="name">Quản lý dự án (PM)</field>
            <field name="department_id" ref="hr_department_dev"/>
            <field name="kpi_template_id" ref="kpi_template_lead"/>
        </record>
        <!-- Bước 5 (Chương 9.2, Ưu tiên 3): bộ BA. B1, B3 chỉ là cấu hình (domain) trên task loại Yêu cầu; B2 cần hàm
             vì phải đi origin_task_id → requirement_id → BA; B4 nhập tay. BA = người trong user_ids của task Yêu cầu. -->
        <record id="kpi_metric_b1" model="kpi.metric">
            <field name="code">B1</field>
            <field name="name">Yêu cầu hoàn thành đúng hạn</field>
            <field name="category">delivery</field>
            <field name="unit">%</field>
            <field name="direction">higher</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'user_ids')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'date_deadline')]"/>
            <field name="aggregation">ratio</field>
            <field name="numerator_domain">[('task_type', '=', 'requirement'), ('is_on_time', '=', True)]</field>
            <field name="denominator_domain">[('task_type', '=', 'requirement'), ('state', '!=', '1_canceled')]</field>
            <field name="description">Task Yêu cầu có deadline trong kỳ, hoàn thành không trễ (cờ is_on_time) / tổng task Yêu cầu có deadline trong kỳ (bỏ task huỷ) × 100. Yêu cầu quá hạn chưa xong tính là trễ; chốt phiếu sau khi kỳ kết thúc.</field>
        </record>
        <record id="kpi_metric_b2" model="kpi.metric">
            <field name="code">B2</field>
            <field name="name">Mật độ bug do yêu cầu sai</field>
            <field name="category">quality</field>
            <field name="unit">bug/yêu cầu</field>
            <field name="direction">lower</field>
            <field name="compute_mode">auto</field>
            <field name="description">Bug có nguyên nhân "Yêu cầu sai" (valid, wont_fix), truy qua task gốc → yêu cầu gốc → BA / số yêu cầu BA hoàn thành trong kỳ. Bug không truy được yêu cầu gốc không quy được về BA (xem báo cáo Kiểm tra dữ liệu).</field>
        </record>
        <record id="kpi_metric_b3" model="kpi.metric">
            <field name="code">B3</field>
            <field name="name">Yêu cầu qua review lần đầu</field>
            <field name="category">process</field>
            <field name="unit">%</field>
            <field name="direction">higher</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'user_ids')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'date_end')]"/>
            <field name="aggregation">ratio</field>
            <field name="numerator_domain">[('task_type', '=', 'requirement'), ('state', '=', '1_done'), '|', ('review_approve_count', '>', 0), ('review_reject_count', '>', 0), ('review_reject_count', '=', 0)]</field>
            <field name="denominator_domain">[('task_type', '=', 'requirement'), ('state', '=', '1_done'), '|', ('review_approve_count', '>', 0), ('review_reject_count', '>', 0)]</field>
            <field name="description">Yêu cầu hoàn thành trong kỳ đã qua review mà chưa từng bị trả về / yêu cầu hoàn thành trong kỳ đã qua review × 100 (cùng quy tắc với D5).</field>
        </record>
        <record id="kpi_metric_b4" model="kpi.metric">
            <field name="code">B4</field>
            <field name="name">Đánh giá của quản lý (BA)</field>
            <field name="category">collaboration</field>
            <field name="unit">điểm</field>
            <field name="direction">higher</field>
            <field name="compute_mode">manual</field>
            <field name="description">Quản lý chấm thang 1-5 về chất lượng tài liệu yêu cầu, phối hợp với Dev và khách hàng.</field>
        </record>
        <record id="kpi_template_ba" model="kpi.template">
            <field name="name">Business Analyst</field>
            <field name="description">Bộ KPI cho phân tích nghiệp vụ: B1, B3 là chỉ số cấu hình, B2 hàm Python, B4 nhập tay.</field>
            <field name="line_ids" eval="[
                (0, 0, {'sequence': 1, 'metric_id': ref('kpi_metric_b1'), 'target': 90, 'weight': 25, 'min_volume': 3}),
                (0, 0, {'sequence': 2, 'metric_id': ref('kpi_metric_b2'), 'target': 0.3, 'weight': 30, 'min_volume': 1}),
                (0, 0, {'sequence': 3, 'metric_id': ref('kpi_metric_b3'), 'target': 70, 'weight': 25, 'min_volume': 3}),
                (0, 0, {'sequence': 4, 'metric_id': ref('kpi_metric_b4'), 'target': 4, 'weight': 20, 'min_volume': 0}),
            ]"/>
        </record>
        <record id="hr_job_ba" model="hr.job">
            <field name="name">Phân tích nghiệp vụ (BA)</field>
            <field name="department_id" ref="hr_department_dev"/>
            <field name="kpi_template_id" ref="kpi_template_ba"/>
        </record>
        <!-- Bước 3: bảng bậc mẫu, chưa gắn vào bộ KPI nào (Admin gắn ở Bộ KPI > cột Bảng bậc để demo) -->
        <record id="kpi_score_scale_default" model="kpi.score.scale">
            <field name="name">Bậc 4 mức (mẫu)</field>
            <field name="description">Dưới 50%: 0 điểm; từ 50%: 50; từ 80%: 80; từ 100%: 100.</field>
            <field name="step_ids" eval="[
                (0, 0, {'pct_from': 0, 'score': 0}),
                (0, 0, {'pct_from': 50, 'score': 50}),
                (0, 0, {'pct_from': 80, 'score': 80}),
                (0, 0, {'pct_from': 100, 'score': 100}),
            ]"/>
        </record>
        <record id="hr_job_tester" model="hr.job">
            <field name="name">Kiểm thử phần mềm (QA)</field>
            <field name="department_id" ref="hr_department_dev"/>
            <field name="kpi_template_id" ref="kpi_template_tester_auto"/>
        </record>
    </data>
</odoo>
