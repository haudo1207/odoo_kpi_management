<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cấu hình mẫu luôn có sẵn sau khi cài module, không phụ thuộc cờ cài demo: phòng ban,
         chức danh và bộ KPI Tester, để chứng minh thêm vai trò mới chỉ cần cấu hình (Phase 8).
         noupdate="1": lệnh -u không ghi đè tên, mục tiêu đã chỉnh trên giao diện. -->
    <data noupdate="1">
        <record id="hr_department_dev" model="hr.department">
            <field name="name">Phòng Phát triển phần mềm</field>
        </record>

        <record id="hr_job_manager" model="hr.job">
            <field name="name">Trưởng nhóm phát triển</field>
            <field name="department_id" ref="hr_department_dev"/>
        </record>

        <record id="hr_job_developer" model="hr.job">
            <field name="name">Lập trình viên</field>
            <field name="department_id" ref="hr_department_dev"/>
            <field name="kpi_template_id" ref="kpi_template_developer"/>
        </record>

        <record id="kpi_period_current_month" model="kpi.period">
            <field name="name" eval="'Tháng ' + DateTime.today().strftime('%m/%Y')"/>
            <field name="period_type">month</field>
            <field name="date_from" eval="DateTime.today().replace(day=1).strftime('%Y-%m-%d')"/>
            <field name="date_to" eval="((DateTime.today().replace(day=28) + relativedelta(days=4)).replace(day=1) - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Phase 8 + Bước 2: vai trò Tester chỉ cấu hình bằng dữ liệu. T4-T6 là chỉ số "domain" —
             khai báo hoàn toàn bằng bản ghi này, KHÔNG có hàm Python (mục đích chính của Bước 2);
             T7 cần hàm _metric_t7 vì tập dự án suy ra từ dữ liệu bug; T8 nhập tay.
             Mã là T4-T8 chứ không phải T1-T5 vì T1-T3 đã bị bộ Tester cũ (Phase 8, chỉ số nhập tay)
             chiếm trên database đã cài và mã chỉ số là UNIQUE; bản ghi cũ nằm trong noupdate nên
             không sửa được bằng XML — hr.job._migrate_tester_template() sẽ ẩn chúng (kpi_migration_data.xml).
             Rủi ro T4: tách một lỗi thành nhiều bug để tăng số lượng. Hai lớp chặn: T5 (bug trùng/không
             hợp lệ bị trừ điểm) và quản lý phân loại bug (bug_resolution) trước khi chốt kỳ. -->
        <record id="kpi_metric_t4" model="kpi.metric">
            <field name="code">T4</field>
            <field name="name">Số bug hợp lệ tìm được</field>
            <field name="category">quality</field>
            <field name="unit">bug</field>
            <field name="direction">higher</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'bug_reporter_id')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'create_date')]"/>
            <field name="aggregation">count</field>
            <field name="numerator_domain">[('task_type', '=', 'bug'), ('bug_resolution', 'in', ['valid', 'wont_fix'])]</field>
            <field name="description">Bug do tester log trong kỳ (bug_reporter_id, ngày tạo) có kết quả xử lý là lỗi thật (valid, wont_fix). Rủi ro: tách một lỗi thành nhiều bug — bị chặn bởi T5 và việc phân loại bug của quản lý.</field>
        </record>
        <record id="kpi_metric_t5" model="kpi.metric">
            <field name="code">T5</field>
            <field name="name">Tỷ lệ bug bị từ chối</field>
            <field name="category">quality</field>
            <field name="unit">%</field>
            <field name="direction">lower</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'bug_reporter_id')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'create_date')]"/>
            <field name="aggregation">ratio</field>
            <field name="numerator_domain">[('task_type', '=', 'bug'), ('bug_resolution', 'in', ['invalid', 'duplicate'])]</field>
            <field name="denominator_domain">[('task_type', '=', 'bug'), ('bug_resolution', '!=', False)]</field>
            <field name="description">Bug trùng/không phải lỗi / bug đã được phân loại × 100. Mẫu số chỉ gồm bug đã có kết quả xử lý.</field>
        </record>
        <record id="kpi_metric_t6" model="kpi.metric">
            <field name="code">T6</field>
            <field name="name">Tỷ lệ bug đủ phân loại</field>
            <field name="category">process</field>
            <field name="unit">%</field>
            <field name="direction">higher</field>
            <field name="compute_mode">domain</field>
            <field name="source_model_id" ref="project.model_project_task"/>
            <field name="user_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'bug_reporter_id')]"/>
            <field name="date_field_id" search="[('model', '=', 'project.task'), ('name', '=', 'create_date')]"/>
            <field name="aggregation">ratio</field>
            <field name="numerator_domain">[('task_type', '=', 'bug'), ('origin_task_id', '!=', False), ('bug_root_cause', '!=', False)]</field>
            <field name="denominator_domain">[('task_type', '=', 'bug')]</field>
            <field name="description">Bug có task gốc và nguyên nhân / mọi bug tester log trong kỳ × 100.</field>
        </record>
        <record id="kpi_metric_t7" model="kpi.metric">
            <field name="code">T7</field>
            <field name="name">Lỗi lọt production của dự án tham gia</field>
            <field name="category">quality</field>
            <field name="unit">%</field>
            <field name="direction">lower</field>
            <field name="compute_mode">auto</field>
            <field name="description">Bug production / bug hợp lệ trong các dự án tester đã log bug trong kỳ × 100. Khối lượng = số dự án tham gia.</field>
        </record>
        <record id="kpi_metric_t8" model="kpi.metric">
            <field name="code">T8</field>
            <field name="name">Đánh giá của quản lý (Tester)</field>
            <field name="category">collaboration</field>
            <field name="unit">điểm</field>
            <field name="direction">higher</field>
            <field name="compute_mode">manual</field>
            <field name="description">Quản lý chấm trên thang 1-5 cho thái độ, phối hợp, chất lượng báo cáo bug.</field>
        </record>
        <record id="kpi_template_tester_auto" model="kpi.template">
            <field name="name">Tester (tự động)</field>
            <field name="description">Bộ KPI kiểm thử viên: T4-T6 tính tự động bằng cấu hình, T7 bằng hàm Python, T8 quản lý nhập.</field>
            <field name="line_ids" eval="[
                (0, 0, {'sequence': 1, 'metric_id': ref('kpi_metric_t4'), 'target': 15, 'weight': 25, 'min_volume': 0}),
                (0, 0, {'sequence': 2, 'metric_id': ref('kpi_metric_t5'), 'target': 10, 'weight': 20, 'min_volume': 3}),
                (0, 0, {'sequence': 3, 'metric_id': ref('kpi_metric_t6'), 'target': 90, 'weight': 15, 'min_volume': 3}),
                (0, 0, {'sequence': 4, 'metric_id': ref('kpi_metric_t7'), 'target': 5, 'weight': 25, 'min_volume': 1}),
                (0, 0, {'sequence': 5, 'metric_id': ref('kpi_metric_t8'), 'target': 4, 'weight': 15, 'min_volume': 0}),
            ]"/>
        </record>
        <record id="hr_job_tester" model="hr.job">
            <field name="name">Kiểm thử phần mềm (QA)</field>
            <field name="department_id" ref="hr_department_dev"/>
            <field name="kpi_template_id" ref="kpi_template_tester_auto"/>
        </record>
    </data>
</odoo>
