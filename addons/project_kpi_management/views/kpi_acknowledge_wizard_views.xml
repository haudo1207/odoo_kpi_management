<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_acknowledge_wizard_view_form" model="ir.ui.view">
        <field name="name">kpi.acknowledge.wizard.form</field>
        <field name="model">kpi.acknowledge.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="evaluation_id" invisible="1"/>
                <group>
                    <field name="decision" widget="radio"/>
                    <field name="comment" placeholder="Bắt buộc khi chọn Có ý kiến"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Huỷ" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
