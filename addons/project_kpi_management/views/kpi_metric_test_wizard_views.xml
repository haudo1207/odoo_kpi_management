<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_metric_test_wizard_view_form" model="ir.ui.view">
        <field name="name">kpi.metric.test.wizard.form</field>
        <field name="model">kpi.metric.test.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="metric_id" invisible="1"/>
                <field name="has_result" invisible="1"/>
                <group>
                    <field name="employee_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <group string="Kết quả" invisible="not has_result">
                    <field name="result_actual"/>
                    <field name="result_volume"/>
                </group>
                <footer>
                    <button name="action_test_compute" string="Thử tính" type="object" class="btn-primary"/>
                    <button string="Đóng" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
