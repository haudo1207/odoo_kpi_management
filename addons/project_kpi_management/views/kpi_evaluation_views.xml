<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_evaluation_view_list" model="ir.ui.view">
        <field name="name">kpi.evaluation.list</field>
        <field name="model">kpi.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="job_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="kpi_score" optional="hide" digits="[16, 2]"/>
                <field name="final_score" digits="[16, 2]"/>
                <field name="final_rating" widget="badge"
                       decoration-success="final_rating == 'excellent'"
                       decoration-info="final_rating == 'good'"
                       decoration-warning="final_rating == 'pass'"
                       decoration-danger="final_rating == 'improve'"/>
                <field name="insufficient_data" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="kpi_evaluation_view_form" model="ir.ui.view">
        <field name="name">kpi.evaluation.form</field>
        <field name="model">kpi.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_kpi" string="Tính KPI" type="object" class="btn-primary"
                            invisible="state != 'draft' or not id or computed_date" groups="project_kpi_management.group_kpi_manager"/>
                    <button name="action_compute_kpi" string="Tính lại KPI" type="object"
                            invisible="state != 'draft' or not computed_date" groups="project_kpi_management.group_kpi_manager"/>
                    <button name="action_submit" string="Gửi duyệt" type="object" class="btn-primary"
                            invisible="state != 'draft' or not computed_date" groups="project_kpi_management.group_kpi_manager"/>
                    <button name="action_approve" string="Duyệt" type="object" class="btn-primary"
                            invisible="state != 'submitted'" groups="project_kpi_management.group_kpi_admin"/>
                    <button name="action_return_draft" string="Trả về nháp" type="object"
                            invisible="state != 'submitted'" groups="project_kpi_management.group_kpi_admin"/>
                    <button name="action_reopen" string="Mở lại" type="object"
                            invisible="state != 'approved'" groups="project_kpi_management.group_kpi_admin"/>
                    <button name="action_open_self_assessment" string="Tự đánh giá" type="object"
                            invisible="not is_own_evaluation or state != 'draft' or not id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="is_own_evaluation" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_late_bugs" type="object" class="oe_stat_button" icon="fa-bug"
                                invisible="late_bug_count == 0">
                            <field name="late_bug_count" widget="statinfo" string="Bug phát sinh muộn"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not insufficient_data or not id">
                        Không đủ dữ liệu đánh giá: trọng số được áp dụng là <field name="applicable_weight" class="oe_inline"/>%.
                        Hệ thống không tự xếp loại. Hãy chọn xếp loại thủ công và ghi lý do trước khi gửi duyệt.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" invisible="not id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="id"/>
                            <field name="period_id" readonly="id" domain="[('state', '=', 'open')]"/>
                            <field name="template_id" readonly="id"/>
                        </group>
                        <group>
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="computed_date" invisible="not computed_date"/>
                            <field name="approved_date" invisible="not approved_date"/>
                        </group>
                    </group>
                    <group invisible="not id">
                        <group string="Điểm">
                            <field name="kpi_score" digits="[16, 2]"/>
                            <field name="manager_adjustment" readonly="state != 'draft'"/>
                            <field name="adjustment_note" readonly="state != 'draft'" required="manager_adjustment != 0"
                                   invisible="manager_adjustment == 0 and not adjustment_note"/>
                            <field name="final_score" class="fw-bold" digits="[16, 2]"/>
                        </group>
                        <group string="Xếp loại">
                            <field name="rating" invisible="insufficient_data"/>
                            <field name="manual_rating" invisible="not insufficient_data" readonly="state != 'draft'"/>
                            <field name="manual_rating_note" invisible="not insufficient_data" readonly="state != 'draft'"/>
                            <field name="final_rating" widget="badge"
                                   decoration-success="final_rating == 'excellent'"
                                   decoration-info="final_rating == 'good'"
                                   decoration-warning="final_rating == 'pass'"
                                   decoration-danger="final_rating == 'improve'"/>
                        </group>
                    </group>
                    <group invisible="not employee_comment" string="Tự đánh giá của nhân viên (tham khảo)">
                        <field name="employee_comment" readonly="1" nolabel="1"/>
                    </group>
                    <notebook invisible="not id">
                        <page string="Chỉ số" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-muted="not is_applicable">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="evaluation_state" column_invisible="1"/>
                                    <field name="metric_id" readonly="1"/>
                                    <field name="compute_mode" optional="hide"/>
                                    <field name="target"/>
                                    <field name="unit"/>
                                    <field name="weight" readonly="1"/>
                                    <field name="min_volume" optional="hide" readonly="1"/>
                                    <field name="volume" optional="show" readonly="1" digits="[16, 2]"/>
                                    <field name="actual" readonly="compute_mode != 'manual'" digits="[16, 4]"/>
                                    <field name="actual_entered" invisible="compute_mode != 'manual'"/>
                                    <field name="is_applicable"/>
                                    <field name="achievement_pct" optional="hide" digits="[16, 2]"/>
                                    <field name="score" digits="[16, 2]"/>
                                    <field name="weighted_score" optional="show" digits="[16, 2]"/>
                                    <field name="self_score" readonly="1" optional="show"
                                           invisible="compute_mode != 'manual'"/>
                                    <field name="remark" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="kpi_evaluation_view_search" model="ir.ui.view">
        <field name="name">kpi.evaluation.search</field>
        <field name="model">kpi.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="period_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <filter name="draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Đã gửi" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Đã duyệt" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="insufficient" string="Không đủ dữ liệu đánh giá" domain="[('insufficient_data', '=', True)]"/>
                <filter name="adjusted" string="Có điều chỉnh điểm" domain="[('manager_adjustment', '!=', 0)]"/>
                <filter name="group_period" string="Kỳ" context="{'group_by': 'period_id'}"/>
                <filter name="group_department" string="Phòng ban" context="{'group_by': 'department_id'}"/>
                <filter name="group_job" string="Chức danh" context="{'group_by': 'job_id'}"/>
                <filter name="group_rating" string="Xếp loại" context="{'group_by': 'final_rating'}"/>
                <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="kpi_evaluation_view_pivot" model="ir.ui.view">
        <field name="name">kpi.evaluation.pivot</field>
        <field name="model">kpi.evaluation</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích phiếu đánh giá" sample="1">
                <field name="department_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="period_id" type="col"/>
                <field name="final_score" type="measure" widget="float" digits="[16, 2]"/>
            </pivot>
        </field>
    </record>

    <record id="kpi_evaluation_view_graph" model="ir.ui.view">
        <field name="name">kpi.evaluation.graph</field>
        <field name="model">kpi.evaluation</field>
        <field name="arch" type="xml">
            <graph string="Xu hướng điểm cuối" type="line" sample="1">
                <field name="period_id"/>
                <field name="final_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="kpi_evaluation_view_graph_rating" model="ir.ui.view">
        <field name="name">kpi.evaluation.graph.rating</field>
        <field name="model">kpi.evaluation</field>
        <field name="arch" type="xml">
            <graph string="Phân bố xếp loại" type="bar" sample="1">
                <field name="final_rating"/>
            </graph>
        </field>
    </record>

    <record id="kpi_evaluation_action" model="ir.actions.act_window">
        <field name="name">Phiếu đánh giá</field>
        <field name="res_model">kpi.evaluation</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <!-- Báo cáo tổng hợp: mở thẳng biểu đồ xu hướng, chuyển sang pivot để xem theo phòng ban/nhân viên -->
    <record id="kpi_evaluation_analysis_action" model="ir.actions.act_window">
        <field name="name">Phân tích phiếu đánh giá</field>
        <field name="res_model">kpi.evaluation</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="kpi_evaluation_view_graph"/>
    </record>

    <record id="kpi_evaluation_rating_action" model="ir.actions.act_window">
        <field name="name">Phân bố xếp loại</field>
        <field name="res_model">kpi.evaluation</field>
        <field name="view_mode">graph,list,form</field>
        <field name="view_id" ref="kpi_evaluation_view_graph_rating"/>
        <field name="context">{'search_default_group_period': 1}</field>
    </record>

    <!-- Phase 7: tính lại KPI cho nhiều phiếu từ danh sách (bỏ qua phiếu không ở Nháp) -->
    <record id="kpi_evaluation_action_recompute" model="ir.actions.server">
        <field name="name">Tính lại KPI</field>
        <field name="model_id" ref="model_kpi_evaluation"/>
        <field name="binding_model_id" ref="model_kpi_evaluation"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('project_kpi_management.group_kpi_manager'))]"/>
        <field name="state">code</field>
        <field name="code">records.filtered(lambda r: r.state == 'draft').action_compute_kpi()</field>
    </record>

    <record id="kpi_evaluation_reason_wizard_view_form" model="ir.ui.view">
        <field name="name">kpi.evaluation.reason.wizard.form</field>
        <field name="model">kpi.evaluation.reason.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="evaluation_id" readonly="1"/>
                    <field name="mode" invisible="1"/>
                    <field name="reason" placeholder="Lý do sẽ được lưu vào lịch sử phiếu"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Huỷ" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
