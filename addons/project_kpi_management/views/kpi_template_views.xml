<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_template_view_list" model="ir.ui.view">
        <field name="name">kpi.template.list</field>
        <field name="model">kpi.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_ids" widget="many2many_tags"/>
                <field name="period_type"/>
                <field name="total_weight"/>
            </list>
        </field>
    </record>

    <record id="kpi_template_view_form" model="ir.ui.view">
        <field name="name">kpi.template.form</field>
        <field name="model">kpi.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Đã ẩn" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VD: Developer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_type"/>
                            <field name="total_weight" decoration-danger="total_weight != 100" decoration-success="total_weight == 100"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="job_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chỉ số" name="lines">
                            <!-- Dòng chỉ sửa trong form template, để ràng buộc tổng trọng số luôn chạy -->
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="metric_id"/>
                                    <field name="target"/>
                                    <field name="unit"/>
                                    <field name="direction"/>
                                    <field name="weight" sum="Tổng"/>
                                    <field name="min_volume"/>
                                    <field name="scale_id"/>
                                    <field name="compute_mode" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mô tả" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_template_view_search" model="ir.ui.view">
        <field name="name">kpi.template.search</field>
        <field name="model">kpi.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_ids"/>
                <filter name="inactive" string="Đã ẩn" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="kpi_template_action" model="ir.actions.act_window">
        <field name="name">Bộ KPI</field>
        <field name="res_model">kpi.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
