<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Báo cáo chi tiết: từng chỉ số của từng phiếu -->
    <record id="kpi_evaluation_line_view_list" model="ir.ui.view">
        <field name="name">kpi.evaluation.line.list</field>
        <field name="model">kpi.evaluation.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="not is_applicable">
                <field name="period_id"/>
                <field name="employee_id"/>
                <field name="department_id" optional="hide"/>
                <field name="metric_id"/>
                <field name="target"/>
                <field name="actual" digits="[16, 4]"/>
                <field name="unit"/>
                <field name="volume" optional="hide" digits="[16, 2]"/>
                <field name="is_applicable"/>
                <field name="score" digits="[16, 2]"/>
                <field name="weight"/>
                <field name="weighted_score" digits="[16, 2]"/>
                <field name="remark" optional="show"/>
                <field name="evaluation_state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="kpi_evaluation_line_view_pivot" model="ir.ui.view">
        <field name="name">kpi.evaluation.line.pivot</field>
        <field name="model">kpi.evaluation.line</field>
        <field name="arch" type="xml">
            <pivot string="Điểm theo chỉ số" sample="1">
                <field name="employee_id" type="row"/>
                <field name="metric_id" type="col"/>
                <field name="score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="kpi_evaluation_line_view_graph" model="ir.ui.view">
        <field name="name">kpi.evaluation.line.graph</field>
        <field name="model">kpi.evaluation.line</field>
        <field name="arch" type="xml">
            <graph string="Điểm trung bình theo chỉ số" type="bar" sample="1">
                <field name="metric_id"/>
                <field name="score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="kpi_evaluation_line_view_search" model="ir.ui.view">
        <field name="name">kpi.evaluation.line.search</field>
        <field name="model">kpi.evaluation.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="metric_id"/>
                <field name="period_id"/>
                <field name="department_id"/>
                <filter name="applicable" string="Được áp dụng" domain="[('is_applicable', '=', True)]"/>
                <filter name="low_score" string="Điểm dưới 75" domain="[('is_applicable', '=', True), ('score', '&lt;', 75)]"/>
                <separator/>
                <filter name="approved" string="Phiếu đã duyệt" domain="[('evaluation_state', '=', 'approved')]"/>
                <filter name="group_metric" string="Chỉ số" context="{'group_by': 'metric_id'}"/>
                <filter name="group_category" string="Nhóm chỉ số" context="{'group_by': 'category'}"/>
                <filter name="group_employee" string="Nhân viên" context="{'group_by': 'employee_id'}"/>
                <filter name="group_department" string="Phòng ban" context="{'group_by': 'department_id'}"/>
                <filter name="group_period" string="Kỳ" context="{'group_by': 'period_id'}"/>
            </search>
        </field>
    </record>

    <!-- Chỉ tính chỉ số được áp dụng: chỉ số "Không áp dụng" có điểm 0 sẽ kéo trung bình xuống sai -->
    <record id="kpi_evaluation_line_analysis_action" model="ir.actions.act_window">
        <field name="name">Phân tích theo chỉ số</field>
        <field name="res_model">kpi.evaluation.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_applicable': 1}</field>
    </record>

    <!-- Kiểm tra dữ liệu -->
    <record id="kpi_data_quality_report_view_list" model="ir.ui.view">
        <field name="name">kpi.data.quality.report.list</field>
        <field name="model">kpi.data.quality.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="done_feature_count"/>
                <field name="sp_rate" digits="[16, 0]" decoration-danger="sp_rate &lt; 80"/>
                <field name="done_count"/>
                <field name="done_without_date_end" decoration-danger="done_without_date_end &gt; 0"/>
                <field name="bug_count"/>
                <field name="origin_rate" digits="[16, 0]" decoration-danger="origin_rate &lt; 80"/>
                <field name="classified_rate" digits="[16, 0]" decoration-danger="classified_rate &lt; 80"/>
                <field name="bug_without_origin" optional="hide"/>
                <field name="bug_unclassified" optional="hide"/>
                <field name="bug_requirement_untraceable" optional="show"/>
                <field name="done_without_sp" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kpi_data_quality_report_view_pivot" model="ir.ui.view">
        <field name="name">kpi.data.quality.report.pivot</field>
        <field name="model">kpi.data.quality.report</field>
        <field name="arch" type="xml">
            <pivot string="Kiểm tra dữ liệu">
                <field name="project_id" type="row"/>
                <field name="bug_without_origin" type="measure"/>
                <field name="bug_unclassified" type="measure"/>
                <field name="bug_requirement_untraceable" type="measure"/>
                <field name="done_without_sp" type="measure"/>
                <field name="done_without_date_end" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="kpi_data_quality_report_action" model="ir.actions.act_window">
        <field name="name">Kiểm tra dữ liệu</field>
        <field name="res_model">kpi.data.quality.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p>Tỷ lệ dưới 80% được tô đỏ: KPI của dự án đó có thể chưa đáng tin vì dữ liệu nhập thiếu.</p>
        </field>
    </record>

    <!-- Mục 5: chỉ số cấp team = dự án, không tính điểm cá nhân -->
    <record id="kpi_team_report_view_list" model="ir.ui.view">
        <field name="name">kpi.team.report.list</field>
        <field name="model">kpi.team.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="feature_done_count"/>
                <field name="on_time_rate" digits="[16, 0]" decoration-danger="on_time_rate &lt; 80"/>
                <field name="bug_count"/>
                <field name="bug_density" digits="[16, 2]"/>
                <field name="production_bug_count"/>
                <field name="production_bug_rate" digits="[16, 0]" decoration-danger="production_bug_rate &gt; 20"/>
                <field name="avg_bug_fix_hours" digits="[16, 1]" optional="show"/>
            </list>
        </field>
    </record>

    <record id="kpi_team_report_view_pivot" model="ir.ui.view">
        <field name="name">kpi.team.report.pivot</field>
        <field name="model">kpi.team.report</field>
        <field name="arch" type="xml">
            <pivot string="Chỉ số theo dự án">
                <field name="project_id" type="row"/>
                <field name="on_time_rate" type="measure"/>
                <field name="bug_density" type="measure"/>
                <field name="production_bug_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="kpi_team_report_action" model="ir.actions.act_window">
        <field name="name">Chỉ số theo dự án</field>
        <field name="res_model">kpi.team.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p>Chỉ số cấp team (team = dự án): tỷ lệ đúng hạn, mật độ lỗi, tỷ lệ lỗi lọt production,
               thời gian sửa bug trung bình. Không quy trách nhiệm cá nhân — dùng để phát hiện vấn đề
               nằm ở quy trình hoặc dự án.</p>
        </field>
    </record>
</odoo>
