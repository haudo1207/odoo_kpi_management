<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_target_override_view_list" model="ir.ui.view">
        <field name="name">kpi.target.override.list</field>
        <field name="model">kpi.target.override</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="template_id"/>
                <field name="metric_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="target"/>
            </list>
        </field>
    </record>

    <record id="kpi_target_override_view_form" model="ir.ui.view">
        <field name="name">kpi.target.override.form</field>
        <field name="model">kpi.target.override</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="template_line_id"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="target"/>
                </group>
                <group string="Gợi ý từ lịch sử (chỉ để tham khảo)">
                    <field name="suggestion_available" invisible="1"/>
                    <field name="suggestion_note"/>
                    <field name="suggestion_easy" invisible="not suggestion_available"/>
                    <field name="suggestion_medium" invisible="not suggestion_available"/>
                    <field name="suggestion_hard" invisible="not suggestion_available"/>
                </group>
                <div invisible="not suggestion_available or not id">
                    <button name="action_apply_easy" string="Áp dụng mức Dễ" type="object" groups="project_kpi_management.group_kpi_admin"/>
                    <button name="action_apply_medium" string="Áp dụng mức Vừa" type="object" class="btn-primary" groups="project_kpi_management.group_kpi_admin"/>
                    <button name="action_apply_hard" string="Áp dụng mức Khó" type="object" groups="project_kpi_management.group_kpi_admin"/>
                </div>
            </form>
        </field>
    </record>

    <record id="kpi_target_override_view_search" model="ir.ui.view">
        <field name="name">kpi.target.override.search</field>
        <field name="model">kpi.target.override</field>
        <field name="arch" type="xml">
            <search>
                <field name="template_id"/>
                <field name="metric_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="group_template" string="Bộ KPI" context="{'group_by': 'template_id'}"/>
                <filter name="group_metric" string="Chỉ số" context="{'group_by': 'metric_id'}"/>
            </search>
        </field>
    </record>

    <record id="kpi_target_override_action" model="ir.actions.act_window">
        <field name="name">Mục tiêu riêng theo nhân viên/phòng ban</field>
        <field name="res_model">kpi.target.override</field>
        <field name="view_mode">list,form</field>
        <field name="help">
            Dùng khi một nhân viên hoặc một phòng ban cần mục tiêu khác với mức mặc định trên bộ KPI
            cho cùng một chỉ số. Khi tạo phiếu, hệ thống lấy mục tiêu theo thứ tự: nhân viên → phòng
            ban → bộ KPI. Chỉ ảnh hưởng phiếu tạo mới, không đổi phiếu đã tạo trước đó.
        </field>
    </record>
</odoo>
