<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_metric_view_list" model="ir.ui.view">
        <field name="name">kpi.metric.list</field>
        <field name="model">kpi.metric</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="unit"/>
                <field name="direction"/>
                <field name="compute_mode"/>
            </list>
        </field>
    </record>

    <record id="kpi_metric_view_form" model="ir.ui.view">
        <field name="name">kpi.metric.form</field>
        <field name="model">kpi.metric</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_test_wizard" string="Thử tính" type="object"
                            invisible="compute_mode != 'domain' or not id"
                            groups="project_kpi_management.group_kpi_admin"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Đã ẩn" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VD: Hoàn thành đúng hạn"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="VD: D1"/>
                            <field name="category"/>
                            <field name="unit" placeholder="VD: %"/>
                        </group>
                        <group>
                            <field name="direction" widget="radio"/>
                            <field name="compute_mode" widget="radio"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Cấu hình tự động (cách tính không cần code)" invisible="compute_mode != 'domain'">
                        <group>
                            <field name="source_model_id"/>
                            <field name="aggregation"/>
                            <field name="value_field_id" invisible="aggregation not in ('sum', 'avg')"/>
                        </group>
                        <group>
                            <field name="user_field_id"/>
                            <field name="date_field_id"/>
                        </group>
                        <field name="numerator_domain" string="Domain (tử số nếu Tỷ lệ)"/>
                        <field name="denominator_domain" invisible="aggregation != 'ratio'"/>
                    </group>
                    <field name="description" placeholder="Công thức tính, nguồn dữ liệu, quy tắc nghiệp vụ..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_metric_view_search" model="ir.ui.view">
        <field name="name">kpi.metric.search</field>
        <field name="model">kpi.metric</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="auto" string="Tự động (code)" domain="[('compute_mode', '=', 'auto')]"/>
                <filter name="domain_mode" string="Tự động (cấu hình)" domain="[('compute_mode', '=', 'domain')]"/>
                <filter name="manual" string="Nhập tay" domain="[('compute_mode', '=', 'manual')]"/>
                <separator/>
                <filter name="higher" string="Cao là tốt" domain="[('direction', '=', 'higher')]"/>
                <filter name="lower" string="Thấp là tốt" domain="[('direction', '=', 'lower')]"/>
                <separator/>
                <filter name="inactive" string="Đã ẩn" domain="[('active', '=', False)]"/>
                <filter name="group_category" string="Nhóm" context="{'group_by': 'category'}"/>
                <filter name="group_direction" string="Chiều" context="{'group_by': 'direction'}"/>
                <filter name="group_compute_mode" string="Cách tính" context="{'group_by': 'compute_mode'}"/>
            </search>
        </field>
    </record>

    <record id="kpi_metric_action" model="ir.actions.act_window">
        <field name="name">Chỉ số KPI</field>
        <field name="res_model">kpi.metric</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
